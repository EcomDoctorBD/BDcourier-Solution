{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Production AWS App Runner Architecture for Bangladeshi Courier Automation Shopify App",
  "Parameters": {
    "ServiceName": {
      "Type": "String",
      "Default": "bd-courier-shopify-app",
      "Description": "The name of the AWS App Runner service"
    },
    "EcrImageUri": {
      "Type": "String",
      "Description": "The ECR image URI (e.g., <aws_account_id>.dkr.ecr.<region>.amazonaws.com/bd-courier-shopify-app:latest)"
    },
    "DatabaseUrl": {
      "Type": "String",
      "NoEcho": true,
      "Description": "MongoDB Atlas connection string (DATABASE_URL)"
    },
    "ShopifyApiKey": {
      "Type": "String",
      "Description": "Shopify App Client ID (API Key)"
    },
    "ShopifyApiSecret": {
      "Type": "String",
      "NoEcho": true,
      "Description": "Shopify App Client Secret"
    },
    "ShopifyScopes": {
      "Type": "String",
      "Default": "write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping",
      "Description": "Configured Shopify OAuth permission scopes"
    },
    "GeminiApiKey": {
      "Type": "String",
      "NoEcho": true,
      "Description": "Google AI Studio Gemini API Key"
    },
    "CpuAllocation": {
      "Type": "String",
      "Default": "1024",
      "AllowedValues": ["1024", "2048"],
      "Description": "CPU allocation (1024 = 1 vCPU, 2048 = 2 vCPU)"
    },
    "MemoryAllocation": {
      "Type": "String",
      "Default": "2048",
      "AllowedValues": ["2048", "3072", "4096"],
      "Description": "Memory allocation (2048 = 2 GB, 4096 = 4 GB)"
    }
  },
  "Resources": {
    "AppRunnerECRAccessRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "${ServiceName}-ecr-access-role" },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "build.apprunner.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSAppRunnerServicePolicyForECRAccess"
        ]
      }
    },
    "AppRunnerService": {
      "Type": "AWS::AppRunner::Service",
      "Properties": {
        "ServiceName": { "Ref": "ServiceName" },
        "InstanceConfiguration": {
          "Cpu": { "Ref": "CpuAllocation" },
          "Memory": { "Ref": "MemoryAllocation" }
        },
        "SourceConfiguration": {
          "AutoDeploymentsEnabled": true,
          "AuthenticationConfiguration": {
            "AccessRoleArn": { "Fn::GetAtt": ["AppRunnerECRAccessRole", "Arn"] }
          },
          "ImageRepository": {
            "ImageIdentifier": { "Ref": "EcrImageUri" },
            "ImageRepositoryType": "ECR",
            "ImageConfiguration": {
              "Port": "3000",
              "RuntimeEnvironmentVariables": [
                { "Name": "NODE_ENV", "Value": "production" },
                { "Name": "HOST", "Value": "0.0.0.0" },
                { "Name": "PORT", "Value": "3000" },
                { "Name": "DATABASE_URL", "Value": { "Ref": "DatabaseUrl" } },
                { "Name": "SHOPIFY_API_KEY", "Value": { "Ref": "ShopifyApiKey" } },
                { "Name": "SHOPIFY_API_SECRET", "Value": { "Ref": "ShopifyApiSecret" } },
                { "Name": "SCOPES", "Value": { "Ref": "ShopifyScopes" } },
                { "Name": "GEMINI_API_KEY", "Value": { "Ref": "GeminiApiKey" } },
                { "Name": "GEMINI_MODEL", "Value": "gemini-1.5-flash" }
              ]
            }
          }
        },
        "HealthCheckConfiguration": {
          "Protocol": "HTTP",
          "Path": "/api/shipping-rates",
          "Interval": 10,
          "Timeout": 5,
          "HealthyThreshold": 1,
          "UnhealthyThreshold": 3
        }
      }
    }
  },
  "Outputs": {
    "AppRunnerServiceArn": {
      "Description": "The ARN of the deployed AWS App Runner Service",
      "Value": { "Fn::GetAtt": ["AppRunnerService", "ServiceArn"] }
    },
    "AppRunnerServiceUrl": {
      "Description": "The live HTTPS production URL of the Shopify Application",
      "Value": { "Fn::Sub": "https://${AppRunnerService.ServiceUrl}" }
    },
    "ShopifyRedirectUrl": {
      "Description": "The OAuth Redirect URL to enter into Shopify Partner Dashboard",
      "Value": { "Fn::Sub": "https://${AppRunnerService.ServiceUrl}/api/auth" }
    },
    "HealthCheckUrl": {
      "Description": "The CarrierService & Target Group Healthcheck Endpoint",
      "Value": { "Fn::Sub": "https://${AppRunnerService.ServiceUrl}/api/shipping-rates" }
    }
  }
}
