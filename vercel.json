{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "remix",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "headers": [
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
